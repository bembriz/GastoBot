{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "harness/config/schemas/evidence.schema.json",
  "title": "Evidence Report",
  "description": "Schema for machine-readable evidence generated by each skill",
  "type": "object",
  "required": ["skill_name", "phase", "timestamp", "status", "summary", "metrics", "checks", "artifacts_generated"],
  "properties": {
    "skill_name": {
      "type": "string",
      "description": "Name of the skill that generated this evidence"
    },
    "phase": {
      "type": "string",
      "enum": ["fase0", "fase1", "fase2", "fase3", "fase4", "fase5"],
      "description": "Phase this evidence belongs to"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of evidence generation"
    },
    "status": {
      "type": "string",
      "enum": ["passed", "failed", "partial"],
      "description": "Overall status of the skill execution"
    },
    "duration_seconds": {
      "type": "number",
      "description": "Total execution time in seconds"
    },
    "summary": {
      "type": "string",
      "description": "One-paragraph executive summary of results"
    },
    "metrics": {
      "type": "object",
      "description": "Key quantitative metrics",
      "properties": {
        "tests_total": { "type": "integer" },
        "tests_passed": { "type": "integer" },
        "tests_failed": { "type": "integer" },
        "coverage_percent": { "type": "number" },
        "errors_count": { "type": "integer" },
        "warnings_count": { "type": "integer" }
      },
      "additionalProperties": true
    },
    "checks": {
      "type": "array",
      "description": "Individual checklist items and their results",
      "items": {
        "type": "object",
        "required": ["id", "description", "status"],
        "properties": {
          "id": { "type": "string" },
          "description": { "type": "string" },
          "status": { "type": "string", "enum": ["passed", "failed", "skipped", "warning"] },
          "detail": { "type": "string" },
          "command": { "type": "string" },
          "output": { "type": "string" }
        }
      }
    },
    "artifacts_generated": {
      "type": "array",
      "description": "List of files created by this skill",
      "items": {
        "type": "object",
        "required": ["path", "type"],
        "properties": {
          "path": { "type": "string" },
          "type": { "type": "string" },
          "description": { "type": "string" }
        }
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": { "type": "string" },
          "message": { "type": "string" },
          "stacktrace": { "type": "string" }
        }
      }
    },
    "warnings": {
      "type": "array",
      "items": { "type": "string" }
    },
    "preconditions_snapshot": {
      "type": "object",
      "description": "Snapshot of preconditions before execution"
    },
    "next_steps": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
